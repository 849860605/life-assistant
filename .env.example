# 复制成 .env 后填写。.env 已加入 .gitignore，不要提交，也不要发给别人。

# ---------- 必填 ----------
# 敏感字段加密密钥：openssl rand -base64 32
LIFE_CRYPTO_KEY=
# 模型 Key：至少填一个，和下面"模型"一节用到的提供方对应
# 阿里云百炼 DashScope（默认提供方）
DASHSCOPE_API_KEY=
# 首次启动时创建的账号（已有账号后不再生效）
LIFE_USERNAME=
LIFE_PASSWORD=
LIFE_ADMIN_USERNAME=
LIFE_ADMIN_PASSWORD=

# ---------- 数据库和 Redis ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=life
DB_USER=life
DB_PASSWORD=life
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 选填：没填对应功能不可用 ----------
# 高德 Web 服务 Key；填好后把 AMAP_MCP_ENABLED 改成 true
AMAP_KEY=
# 高德 Web 端（JS API）Key 和安全密钥：页面上能拖动、缩放的地图；不填就用静态地图图片
AMAP_JS_KEY=
AMAP_JS_SECURITY=
AMAP_MCP_ENABLED=false
# 和风天气：控制台里的 API Host（如 abcxyz.re.qweatherapi.com）和 API KEY
QWEATHER_API_HOST=
QWEATHER_API_KEY=
# 和风天气 JWT 认证（推荐；2027-01-01 起 API KEY 每天限量）。填了这四项就不用 API KEY：
# 开发者 ID（Q 开头，控制台 → 设置）、项目 ID 和凭据 ID（控制台 → 项目管理）、Ed25519 私钥（只填 PEM 中间那段也行）
QWEATHER_DEVELOPER_ID=
QWEATHER_PROJECT_ID=
QWEATHER_KEY_ID=
QWEATHER_PRIVATE_KEY=
# RollingGo 酒店 MCP（实时房型和价格，个人免费）：https://travelportal-partner-center.dida.com/register?lang=zh
ROLLINGGO_API_KEY=
# 携程问道（酒店价格和房型，不填也能低频匿名使用）：https://www.ctrip.com/wendao/openclaw
TRIPAI_API_KEY=
# 美团酒旅 ht-ai（酒店价格）：https://developer.meituan.com/zh/v2/dev/token
MEITUAN_HT_TOKEN=
# 飞猪 FlyAI（酒店价格）：https://flyai.open.fliggy.com
FLYAI_API_KEY=
# 飞猪命令行工具的路径：cd tools && npm install 后是 <项目目录>/tools/node_modules/.bin/flyai
FLYAI_COMMAND=
# 博查联网搜索（搜攻略，含小红书笔记摘要）：https://open.bochaai.com
BOCHA_API_KEY=
# Bark 服务地址，自建 bark-server 时改成自己的
BARK_SERVER=https://api.day.app

# ---------- 其他模型提供方（选填，用哪家填哪家） ----------
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
# 火山方舟（豆包）
ARK_API_KEY=
OPENAI_API_KEY=
# OpenAI 兼容的中转或自建服务地址，不含 /v1
OPENAI_BASE_URL=https://api.openai.com

# ---------- 模型 ----------
# 写法"提供方:型号"，例如 LIFE_MODEL_SKILL=deepseek:deepseek-chat；不写前缀用默认提供方
# 提供方名：dashscope / deepseek / moonshot / zhipu / doubao / openai，型号以各家控制台为准
LIFE_LLM_DEFAULT_PROVIDER=dashscope
LIFE_MODEL_ROUTER=qwen-turbo
LIFE_MODEL_SKILL=qwen-plus
LIFE_MODEL_PLANNER=qwen-max
LIFE_MODEL_VISION=qwen-vl-plus

# 途牛开放接口 Key
TUNIU_API_KEY=

# ---------- 邮件验证码（注册、找回密码、绑定邮箱） ----------
# QQ 邮箱：smtp.qq.com、465 端口，密码填邮箱设置里生成的授权码，不是 QQ 密码；不填就不能邮箱注册
LIFE_MAIL_HOST=
LIFE_MAIL_PORT=465
LIFE_MAIL_USERNAME=
LIFE_MAIL_PASSWORD=
# 全站每天最多发多少封
LIFE_MAIL_DAILY_LIMIT=300

# 打开接口调试页面 /swagger-ui.html（线上保持关闭）
LIFE_API_DOCS=false

# ---------- 支付宝收款（AI 网页应用收款） ----------
# sandbox：用项目根目录的 .alipay-sandbox.json（快速沙箱，已被 .gitignore 排除），打包运行时用 ALIPAY_SANDBOX_CONFIG 指定绝对路径
# production：填下面的正式应用配置。私钥 Java 用 PKCS#8 原始字符串，不带 PEM 头尾；APPID、应用私钥、支付宝公钥必须属于同一个正式应用
ALIPAY_MODE=sandbox
ALIPAY_SANDBOX_CONFIG=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 收款账号 PID（2088 开头），异步通知里的 seller_id 要和它一致
ALIPAY_SELLER_ID=
# 异步通知地址：公网 HTTPS，例如 https://你的域名/api/v1/pay/alipay/notify；本地没有就留空
ALIPAY_NOTIFY_URL=
# 付款后回到的结果页：本地不用填（默认 http://localhost:5173/api/v1/pay/alipay/return），线上取消注释改成自己的域名
# ALIPAY_RETURN_URL=https://你的域名/api/v1/pay/alipay/return

# 飞常准（航班实时动态），https://ai.variflight.com 申请，按次计费
VARIFLIGHT_API_KEY=
